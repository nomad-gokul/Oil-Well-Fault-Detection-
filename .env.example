# Copy to .env and adjust. All settings use the OWFD_ prefix.
OWFD_RAW_DATA_DIR=data/raw
OWFD_DATASET_DIR=data/raw/3W/dataset
OWFD_PROCESSED_DATA_DIR=data/processed
OWFD_ARTIFACTS_DIR=artifacts
OWFD_RANDOM_SEED=42

# API (Tasks 13-14)
# OWFD_SERVING_BUNDLE=artifacts/serving/<version>
# OWFD_API_KEY=change-me
# OWFD_CORS_ORIGINS=["http://localhost:8501"]
# OWFD_DATABASE_URL=sqlite:///data/owfd.db   # or postgresql+psycopg://user:pass@host/db
# OWFD_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# OWFD_DEMO_MODE=true          # replay bundled demo wells on startup
# OWFD_DEMO_SPEED=60
